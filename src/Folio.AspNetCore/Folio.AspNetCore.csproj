<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <!-- FolioClientConfig is serialize-only (never deserialized), so the
         init-only-properties warning from the JSON source generator is a
         false positive on older TFMs. -->
    <NoWarn>$(NoWarn);SYSLIB1037</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Folio.AspNetCore</PackageId>
    <Version>1.0.1</Version>
    <Authors>Anushervon</Authors>
    <Description>An embeddable OpenAPI documentation and testing UI for ASP.NET Core. Renders your app's OpenAPI spec through its own UI, with no separate infrastructure required.</Description>
    <PackageTags>openapi;swagger;scalar;documentation;aspnetcore;api</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bekov0004/Folio.AspNetCore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bekov0004/Folio.AspNetCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- UI assets are embedded directly from Spectra-Prototype/htdocs — a
       single source of truth for both the standalone prototype and the
       NuGet package, no manual file copying between repos. The spec files
       (*.json at the root of htdocs) are the prototype's own test data and
       are not included in the package: the real spec is always supplied by
       the host app via FolioOptions.SpecUrl. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../Spectra-Prototype/htdocs/index.html">
      <Link>wwwroot/index.html</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="../../../Spectra-Prototype/htdocs/css/**/*.css">
      <Link>wwwroot/css/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="../../../Spectra-Prototype/htdocs/js/**/*.js">
      <Link>wwwroot/js/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <!-- Self-hosted fonts (Google Fonts) — the UI makes zero external
         requests and works fully offline. -->
    <EmbeddedResource Include="../../../Spectra-Prototype/htdocs/fonts/**/*.woff2">
      <Link>wwwroot/fonts/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Condition="Exists('../../README.md')" />
  </ItemGroup>

</Project>
